# Copy to .env on the VPS and fill in real values.
# Never commit the real .env.

# Real domain the stack is served on (Caddy auto-HTTPS via Let's Encrypt).
# DNS must point this at the VPS before first boot. Replace example.com.
DOMAIN=example.com

DB_PASSWORD=change-me-to-a-long-random-string
SECRET_KEY=change-me-to-a-long-random-secret-key
ANTHROPIC_API_KEY=

# Embeddings — self-hosted Ollama by default. "voyage" or "none" optional.
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_CONTEXT_LENGTH=2048
EMBEDDING_CHARS_PER_TOKEN=4.0
VOYAGE_API_KEY=

# Admin seeding: in production the default-admin seed runs ONLY if this is
# changed from the default "changeme".
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me

# Unused for same-origin calls through Caddy; kept for completeness.
CORS_ORIGINS=https://example.com

CELERY_CONCURRENCY=2